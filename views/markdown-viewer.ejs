<!DOCTYPE html>
<html lang="pt-BR" style="font-size: <%= typeof ui !== 'undefined' ? ui.fontScale : '100' %>%;">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= document ? document.title : 'Documento indisponível' %> - PS Panel</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/styles.css">
    <style>
        html {
            scroll-behavior: smooth;
        }

        .markdown-header-actions {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            flex: 0 0 auto;
        }

        .markdown-back-button {
            white-space: nowrap;
        }

        .main-content {
            min-width: 0;
        }

        .markdown-viewer-page {
            max-width: 100%;
            width: min(100%, 72rem);
            margin: 0 auto;
            padding: clamp(1.25rem, 4vw, 3.5rem);
            border: 1px solid var(--border-color);
            border-radius: 0.75rem;
            background: var(--bg-dark);
            box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.22);
        }

        .markdown-body {
            color: #e2e8f0;
            line-height: 1.7;
            overflow-wrap: anywhere;
        }

        .markdown-body > :first-child {
            margin-top: 0;
        }

        .markdown-body > :last-child {
            margin-bottom: 0;
        }

        .markdown-body h1,
        .markdown-body h2,
        .markdown-body h3,
        .markdown-body h4,
        .markdown-body h5,
        .markdown-body h6 {
            scroll-margin-top: 5rem;
            margin: 1.7em 0 0.65em;
            color: #f8fafc;
            line-height: 1.25;
        }

        .markdown-body h1,
        .markdown-body h2 {
            padding-bottom: 0.45rem;
            border-bottom: 1px solid var(--border-color);
        }

        .markdown-body h1 {
            font-size: clamp(1.7rem, 4vw, 2.25rem);
        }

        .markdown-body h2 {
            font-size: clamp(1.35rem, 3vw, 1.7rem);
        }

        .markdown-body h3 {
            font-size: 1.25rem;
        }

        .markdown-body p,
        .markdown-body ul,
        .markdown-body ol,
        .markdown-body blockquote,
        .markdown-body table,
        .markdown-body pre {
            margin: 0 0 1rem;
        }

        .markdown-body ul,
        .markdown-body ol {
            padding-left: 1.6rem;
        }

        .markdown-body li + li {
            margin-top: 0.3rem;
        }

        .markdown-body a {
            color: #60a5fa;
            text-underline-offset: 0.18rem;
        }

        .markdown-disabled-link {
            color: var(--text-secondary);
            text-decoration: line-through dotted;
            cursor: not-allowed;
        }

        .markdown-body blockquote {
            padding: 0.75rem 1rem;
            border-left: 0.25rem solid #60a5fa;
            color: #cbd5e1;
            background: rgba(30, 41, 59, 0.65);
        }

        .markdown-body code {
            padding: 0.12rem 0.35rem;
            border-radius: 0.3rem;
            color: #bae6fd;
            background: #020617;
            font-family: Consolas, 'Courier New', monospace;
            font-size: 0.9em;
        }

        .markdown-body pre {
            max-width: 100%;
            padding: 1rem;
            overflow-x: auto;
            border: 1px solid #1e3a5f;
            border-radius: 0.55rem;
            background: #020617;
        }

        .markdown-body pre code {
            padding: 0;
            color: #dbeafe;
            background: transparent;
            white-space: pre;
        }

        .markdown-body table {
            display: block;
            width: 100%;
            overflow-x: auto;
            border-collapse: collapse;
        }

        .markdown-body th,
        .markdown-body td {
            padding: 0.55rem 0.75rem;
            border: 1px solid var(--border-color);
            text-align: left;
            vertical-align: top;
        }

        .markdown-body th {
            color: #f8fafc;
            background: var(--bg-light);
        }

        .markdown-body tr:nth-child(even) {
            background: rgba(30, 41, 59, 0.35);
        }

        .markdown-body hr {
            margin: 1.8rem 0;
            border: 0;
            border-top: 1px solid var(--border-color);
        }

        .markdown-body img {
            max-width: 100%;
            height: auto;
        }

        .markdown-viewer-error {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: calc(100vh - 10rem);
            text-align: center;
        }

        .markdown-viewer-error i {
            margin-bottom: 1rem;
            color: var(--danger-color);
            font-size: 3rem;
        }

        .markdown-viewer-error h2 {
            margin-bottom: 0.65rem;
        }

        .markdown-viewer-error p {
            max-width: 36rem;
            color: var(--text-secondary);
        }

        @media (max-width: 620px) {
            .top-header {
                align-items: stretch;
                flex-direction: column;
            }

            .markdown-header-actions {
                width: 100%;
                justify-content: space-between;
            }

            .markdown-viewer-page {
                width: 100%;
                padding: 1rem;
                box-shadow: none;
            }

            .markdown-body table {
                font-size: 0.85rem;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/sidebar', { activeMenu: 'documentation', user: user }) %>

    <main class="main-content">
        <header class="top-header">
            <div class="header-title">
                <h1><%= document ? document.title : 'Documento indisponível' %></h1>
                <p><%= document ? 'Visualização do arquivo ' + document.fileName + '.' : 'Não foi possível exibir o arquivo solicitado.' %></p>
            </div>
            <div class="markdown-header-actions">
                <button
                    id="backToPreviousPage"
                    class="secondary-btn markdown-back-button"
                    type="button"
                    data-fallback="/documentation<%= document && (document.section === 'development' || document.section === 'tasks') ? '?view=development' : '' %>"
                >
                    <i class="fas fa-arrow-left" aria-hidden="true"></i>
                    Voltar
                </button>
                <img src="/logo.png" alt="Logo" class="header-logo">
            </div>
        </header>

        <% if (messages.error && messages.error.length) { %>
            <div class="alert alert-danger"><%= messages.error[0] %></div>
        <% } %>

        <section class="markdown-viewer-page">
            <% if (document) { %>
                <%# Seguro: html e links perigosos são desabilitados/filtrados pelo markdown-it no servidor. %>
                <article class="markdown-body"><%- document.html %></article>
            <% } else { %>
                <section class="markdown-viewer-error">
                    <i class="fas fa-file-circle-exclamation" aria-hidden="true"></i>
                    <h2>Documento indisponível</h2>
                    <p><%= errorMessage %></p>
                </section>
            <% } %>
        </section>

        <%- include('partials/app-footer') %>
    </main>

    <script>
        document.getElementById('backToPreviousPage').addEventListener('click', (event) => {
            const fallback = event.currentTarget.dataset.fallback;
            let hasInternalReferrer = false;
            try {
                hasInternalReferrer = document.referrer && new URL(document.referrer).origin === window.location.origin;
            } catch (error) {
                hasInternalReferrer = false;
            }

            if (hasInternalReferrer) {
                window.history.back();
                return;
            }

            window.location.assign(fallback);
        });
    </script>
</body>
</html>
